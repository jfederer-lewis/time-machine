# Copy to .dev.vars and fill in when ready.
# Never commit real keys.

# Google Gemini — grounded discovery + polish/phrasing + claim verify
# (never the public citation; candidates need an allowlisted URL that backs the date)
GEMINI_API_KEY=

# Perplexity Search — allowlisted contemporary press discovery + claim cite upgrades
PERPLEXITY_API_KEY=

# New York Times Archive / Article Search (1851–present metadata)
NYT_API_KEY=

# The Guardian Open Platform (1999–present)
GUARDIAN_API_KEY=

# Optional: GDELT Cloud for structured post-1979 events
GDELT_API_KEY=

# Force mock data even when keys exist (useful for demos)
USE_FALLBACK=true
